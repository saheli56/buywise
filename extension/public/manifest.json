{
  "manifest_version": 3,
  "name": "Buywise Assistant",
  "version": "1.0",
  "description": "Intelligent shopping assistant and recommendation agent.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["*://*.amazon.com/*"],
  "action": {
    "default_popup": "index.html"
  },
  "content_scripts": [
    {
      "matches": ["*://*.amazon.com/*"],
      "js": ["src/content/scraper.js"],
      "css": ["src/content/overlay.css"]
    }
  ],
  "background": {
    "service_worker": "src/background/service_worker.js",
    "type": "module"
  }
}
