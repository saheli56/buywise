{
  "manifest_version": 3,
  "name": "Buywise Assistant",
  "version": "1.0",
  "description": "Premium intelligent shopping assistant and recommendation agent.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["*://*.amazon.com/*", "*://*.amazon.in/*", "http://localhost:8000/*"],
  "action": {
    "default_popup": "index.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.amazon.com/*", "*://*.amazon.in/*"],
      "js": ["scraper.js"],
      "run_at": "document_idle"
    }
  ]
}
